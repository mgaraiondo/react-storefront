# Variables de entorno para Saleor Storefront
# Copia este archivo como .env y rellena los valores

# Token de autenticación para la API de Saleor
# Puedes obtener este token desde el panel de administración de Saleor:
# 1. Accede a http://localhost:9000 (o tu URL de administración)
# 2. Ve a Configuración > Aplicaciones
# 3. Crea una nueva aplicación o usa una existente
# 4. Genera un token con los permisos AUTHENTICATED_APP o AUTHENTICATED_STAFF_USER
# 5. Copia el token aquí
SALEOR_APP_TOKEN=byaCCLGn2GeWejGRNDUCurxavQ1vMN


# URL de la API GraphQL de Saleor
NEXT_PUBLIC_GRAPHQL_URL=http://api:8000/graphql/

# URL del storefront
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000

# Otras variables de entorno
# NODE_ENV=development
# ALWAYS_AUTH=true  # Descomenta para incluir el token en todas las peticiones
